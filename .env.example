# Google OAuth 2.0 credentials
# Google Cloud Console → APIs & Services → Credentials で作成
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth コールバック URL（Cloud Run のドメインに合わせる）
REDIRECT_URI=https://staff.marunouchi-rinri.org/auth/callback

# Google スプレッドシート ID
# スプレッドシートのURLから取得: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_ID=your-spreadsheet-id

# JWT シークレットキー（ランダム文字列を生成して設定）
JWT_SECRET=your-random-secret-key-here

# Cloud Run サービスアカウントがスプレッドシートへアクセスするための認証情報
# Cloud Run 上では Application Default Credentials が使われるため通常は不要
# ローカルテストが必要な場合のみ指定
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
